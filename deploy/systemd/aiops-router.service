# ============================================================================
# Sentinel Router（调度中心）systemd 单元
# design §1.2：内部 API 仅绑定 127.0.0.1:18081；SQLite 单写者（严禁多实例！）
#
# 安装（bootstrap.sh 已自动完成；手动方式）：
#   sudo cp deploy/systemd/aiops-router.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now aiops-router
#
# 常用运维命令：
#   systemctl status aiops-router --no-pager   # 状态
#   journalctl -u aiops-router -f              # 实时日志
#   sudo systemctl restart aiops-router        # 改 /etc/aiops/config.yaml 后重启
# ============================================================================
[Unit]
Description=Sentinel AIOps Router (调度中心：降噪/分诊/状态机/派发)
# 网络就绪后启动（SQLite 为本地库，无外部依赖）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 低权限专用用户（bootstrap.sh 创建）；runtime 目录 root:aiops 只读 → 防自我修改
User=aiops
Group=aiops
# 禁止写 .pyc：runtime 目录只读，避免 Python 启动时写 __pycache__ 报错
Environment=PYTHONDONTWRITEBYTECODE=1
# 密钥以环境变量注入（文件 root:root 0600，由 systemd 以 root 读取）
EnvironmentFile=/etc/aiops/secrets.env
# 外网统一走宿主机代理（内网限制，2026-11-04 部署确认）：
# 飞书 / LLM 都是外网服务，进程内 httpx 依赖这些变量（trust_env）
# NO_PROXY 必须含本机回环，否则内部 API 调用（127.0.0.1:18081/18000）也会被代理拦截
Environment=HTTP_PROXY=http://10.139.242.1:8888
Environment=HTTPS_PROXY=http://10.139.242.1:8888
Environment=NO_PROXY=127.0.0.1,localhost
WorkingDirectory=/opt/aiops/runtime
# 监听地址/端口读取 /etc/aiops/config.yaml 的 router 段（默认 127.0.0.1:18081）
# 注意：单写者约束 → 不要配置多 worker/多实例运行
ExecStart=/opt/aiops/venv/bin/python -m src.router.main
# 崩溃自动拉起（design R0.4）
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
