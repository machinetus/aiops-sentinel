# ============================================================================
# Sentinel Demo App（被监控业务应用）systemd 单元
# 代码在【阶段 2】落地（target-app/，pip install -e 安装为 demo_app 包）；
# bootstrap.sh 只安装不启用。阶段 2 完成后手动启用：
#   sudo /opt/aiops/venv-demo/bin/pip install -e /opt/aiops/deploy/target-app
#   sudo systemctl enable --now demo-app
#
# 缺陷开关（design §9.3 BUG_MODE）：
#   type_bug（默认）: /api/orders 对字符串 amount 直接 int() → ValueError/500
#                     —— 场景二「代码缺陷修复闭环」的触发源
#   off             : 无缺陷，回归基线 / 复测用
# ============================================================================
[Unit]
Description=Sentinel Demo App (被监控业务应用：FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# demoapp 运行业务应用；Group=aiops 使日志文件组可读（日志探针采集用）
User=demoapp
Group=aiops
# /run/demo-app 由 systemd 自动创建（demoapp 可写）：admin API 状态落盘 state.json
RuntimeDirectory=demo-app
Environment=BUG_MODE=type_bug
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/aiops/deploy
# 业务端口 :18000（VM 内可达，宿主机经 VMware 端口转发访问；
# 8000 在目标 VM 上已被既有服务占用，2026-11-04 部署确认后改用 18000）
# 管理端口 127.0.0.1:9101（限流/封禁 admin API，仅本机，Agent 专用）
ExecStart=/opt/aiops/venv-demo/bin/python -m uvicorn demo_app.main:app --host 0.0.0.0 --port 18000
# 日志落文件（design §3.1 日志探针的数据源）：/var/log/demo-app/app.log
StandardOutput=append:/var/log/demo-app/app.log
StandardError=append:/var/log/demo-app/app.log
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
